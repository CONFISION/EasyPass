-- Folders table for organizing password entries
CREATE TABLE folders (
  id TEXT PRIMARY KEY NOT NULL,
  name TEXT NOT NULL,
  icon TEXT DEFAULT 'folder',
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL
);

-- Vault entries (the main vault items).
--
-- 2.3.0 起一个条目有四种类型（login / secure_note / identity / ssh_key）：
--   * type             —— 明文类型标签，用于列表分组、自动填充过滤（只有 login 参与）
--   * data_encrypted   —— 类型专属字段（身份 / SSH）+ 自定义字段的加密 JSON；
--                         登录字段仍走 url / username / password_encrypted /
--                         totp_secret_encrypted 这几列，保证旧数据零迁移。
-- 详见 lib/data/models/vault_item.dart。
CREATE TABLE password_entries (
  id TEXT PRIMARY KEY NOT NULL,
  folder_id TEXT,
  type TEXT NOT NULL DEFAULT 'login',
  name TEXT NOT NULL,
  url TEXT NOT NULL DEFAULT '',
  username TEXT NOT NULL DEFAULT '',
  password_encrypted TEXT NOT NULL,
  notes_encrypted TEXT DEFAULT '',
  totp_secret_encrypted TEXT DEFAULT '',
  data_encrypted TEXT NOT NULL DEFAULT '',
  is_favorite BOOLEAN NOT NULL DEFAULT FALSE,
  -- 回收站（schema 5，3.1.0）：NULL = 正常；非 NULL = 删除时间（毫秒）。
  -- 「删除」只打这个标记，行与密文一个字节都不动；「恢复」就是置回 NULL。
  -- 主密码轮换会照样遍历回收站行（getAllEntries），否则那些密文会留在旧钥匙上。
  deleted_at INTEGER,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  FOREIGN KEY (folder_id) REFERENCES folders(id) ON DELETE SET NULL
);

-- Indexes for performance
CREATE INDEX idx_password_entries_folder ON password_entries(folder_id);
CREATE INDEX idx_password_entries_name ON password_entries(name);
CREATE INDEX idx_password_entries_favorite ON password_entries(is_favorite);
CREATE INDEX idx_password_entries_type ON password_entries(type);

-- 索引：回收站（schema 5）用。
CREATE INDEX idx_password_entries_deleted ON password_entries(deleted_at);

-- 键值元数据表（schema 3 新增）。
--
-- 目前唯一的用途是**改主密码的轮换日志**（`rotation.*` 键）。
--
-- 为什么必须放在这个库里：改主密码要跨两个存储系统原子地换钥匙 ——
-- 条目密文在 SQLite（有事务），校验哈希在 flutter_secure_storage（没有事务）。
-- 把"目标 salt / 目标校验哈希"和重加密写进**同一个 SQLite 事务**，
-- 两者就一起提交或一起回滚；secure storage 那一步失败时，日志还在，
-- 下次解锁可以据此把轮换补完。详见
-- `lib/data/services/master_password_rotation.dart`。
CREATE TABLE vault_meta (
  meta_key TEXT PRIMARY KEY NOT NULL,
  meta_value TEXT NOT NULL
);

-- 智能体（MCP）访问审计（schema 4 新增）。
--
-- 为什么必须进库而不是留在内存：方式 2（可信直通）对用户的承诺是
-- "每次访问都留日志"。内存环形缓冲重启即丢，等于承诺没兑现。
--
-- 安全纪律：**只存"发生了什么"，不存秘密**。
-- - `nickname` 是用户在配对时起的名字（审计里唯一允许出现的身份信息）；
-- - **绝不**存配对密钥、真实客户端标识、明文参数或条目字段值；
-- - `entry_name` 用于让用户看懂"动的是哪一条"，它本来就是明文列。
CREATE TABLE agent_audit (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  at INTEGER NOT NULL,
  pairing_id TEXT NOT NULL,
  nickname TEXT NOT NULL,
  mode TEXT NOT NULL,
  tool TEXT NOT NULL,
  op TEXT NOT NULL,
  entry_id TEXT,
  entry_name TEXT,
  decision TEXT NOT NULL
);

CREATE INDEX idx_agent_audit_at ON agent_audit(at);
